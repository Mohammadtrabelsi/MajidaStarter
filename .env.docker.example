# ---------------------------------------------------------------------------
# Docker Compose environment (the OUTER stack).
# Copy this file to ".env" in the project root:  cp .env.docker.example .env
#
# NOTE: This is NOT Laravel's .env. Laravel keeps its own .env inside ./src.
# The values here configure the containers (ports, MySQL credentials, etc.).
# Make sure the DB_* values below match the ones in src/.env.
# ---------------------------------------------------------------------------

# Compose project name (used as a prefix for container/image names)
COMPOSE_PROJECT_NAME=majida

# Local user mapping so files created in the container are owned by you
UID=1000
GID=1000

# Host ports (change these if something already uses them locally)
APP_PORT=8080     # http://localhost:8080  -> the Laravel app
PMA_PORT=8081     # http://localhost:8081  -> phpMyAdmin
DB_PORT=3306      # MySQL, exposed on the host
REDIS_PORT=6379   # Redis, exposed on the host

# MySQL credentials (the "db" service is initialised with these)
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
