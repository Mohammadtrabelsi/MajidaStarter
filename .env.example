APP_NAME=MajidaStarter
APP_ENV=local
APP_KEY=base64:PSMzL/GZsy+tNFuo0VC414Z0cw3C+/OrfVZXvBFK+8E=
APP_DEBUG=true
APP_URL=http://majidastarter.test
GITHUB_URL=https://github.com/Mohammadtrabelsi/MajidaStarter

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=majidastarter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SEO & feeds ----------------------------------------------------------
SEO_STRUCTURED_DATA=true
# SEO_ORGANIZATION_LOGO=images/favicon_io/android-chrome-512x512.png
# SEO_SAME_AS=https://github.com/you,https://www.linkedin.com/company/you
FEED_ENABLED=true
FEED_LIMIT=20
# FEED_TITLE="${APP_NAME} — Blog"

# --- Spam protection (register / forgot-password) -------------------------
HONEYPOT_ENABLED=true
HONEYPOT_SECONDS=1

# --- Backups (spatie/laravel-backup) --------------------------------------
# Comma-separated disks from config/filesystems.php, e.g. "backups,s3".
BACKUP_DISKS=backups
BACKUP_SCHEDULE_ENABLED=true
BACKUP_RUN_AT=01:30
BACKUP_NOTIFICATION_EMAIL=
# Strongly recommended for off-site disks. Store it outside the backup!
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_AGE_DAYS=1
BACKUP_MAX_STORAGE_MB=5000
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=16

# --- Health monitoring (spatie/laravel-health) ----------------------------
HEALTH_NOTIFICATION_EMAIL=
# Enables GET /health.json for uptime monitors (send as a bearer token).
HEALTH_SECRET_TOKEN=
HEALTH_DISK_WARN_PERCENT=70
HEALTH_DISK_FAIL_PERCENT=90

# --- PDF (spatie/laravel-pdf) ---------------------------------------------
# dompdf (pure PHP, default) | browsershot | chrome | gotenberg | weasyprint
LARAVEL_PDF_DRIVER=dompdf
PDF_FORMAT=a4
PDF_ORIENTATION=portrait

# --- CSV / Excel imports --------------------------------------------------
IMPORT_MAX_KB=5120
IMPORT_MAX_ROWS=5000
