includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    # Level 0 is the loosest, 10 (max) is the strictest.
    # Start here and raise it as the codebase is cleaned up.
    level: 5

    ignoreErrors:
        #- '#PHPDoc tag @var#'

        # Consumed by Volt single-file components under resources/views, which sit
        # outside the `app` analysis path (and can't be added: they mix Blade with PHP).
        - identifier: trait.unused
          path: app/Support/Livewire/InteractsWithToasts.php

    excludePaths:
        #- ./*/*/FileToBeExcluded.php
